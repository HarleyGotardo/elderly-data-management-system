            <input
              type="password"
              value={formData.password}
              onChange={(e) => setFormData({...formData, password: e.target.value})}
              style={{
                width: '100%',
                padding: '10px 15px',
                border: '1px solid #dee2e6',
                borderRadius: '0',
                fontSize: '14px',
                background: 'white',
