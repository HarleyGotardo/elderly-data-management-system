              }}
              disabled={loading}
            />
            {errors.password && (
              <div style={{ color: '#dc3545', fontSize: '12px', marginTop: '5px' }}>
                {errors.password}
              </div>
            )}
          </div>
          
          <div style={{ marginBottom: '30px' }}>
